# Prevent directory indexing and script execution in uploads
Options -Indexes -ExecCGI

<FilesMatch "\.(php[0-9]?|phtml|phar|phps|cgi|pl|py|sh|htaccess|shtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
